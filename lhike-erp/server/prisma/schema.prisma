// LHIKE ERP - Prisma schema
// Postgres in production (provisioned automatically via the Netlify DB /
// Neon extension -- see server/scripts/provision-db.mjs and
// netlify/functions/api.mts). Local development also uses Postgres when
// DATABASE_URL points at one; see server/.env.example.

// output: generates the client (default native-engine build, see
// src/db.ts) directly into netlify/functions/generated/prisma-client
// instead of server/node_modules. Marking "@prisma/client" as
// external_node_modules in netlify.toml was NOT enough to get its files
// into the deployed function bundle -- confirmed in production via
// "Cannot find module '@prisma/client/wasm'". Generating straight into the
// functions directory and importing by relative path (see src/db.ts)
// sidesteps package/node_modules resolution entirely and relies only on
// plain sibling files, which is already proven to survive Netlify's
// bundling (see server/scripts/provision-db.mjs's generated
// _generated-db-env.mjs). The wasm engine + Neon driver adapter combo
// (previewFeatures = ["driverAdapters"]) got past that bundling problem
// but then failed to initialize in the Netlify build container itself
// with a Prisma/Node 24 wasm-loading error, so this generates the native
// engine binary instead -- built fresh in the same container it deploys
// into, avoiding the cross-platform mismatch native engines usually risk.
generator client {
  provider = "prisma-client-js"
  output   = "../../netlify/functions/generated/prisma-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Mirrors Module 9 (User Management): Employment Status is separate from
// the Enabled/Disabled login toggle. Validated as one of
// Active/Inactive/Resigned/Terminated at the application layer (see
// src/routes/users.ts) rather than as a Prisma enum.
model User {
  id            String   @id @default(cuid())
  employeeNo    String   @unique
  firstName     String
  lastName      String
  middleName    String?
  birthdate     DateTime?
  contactNumber String?
  personalEmail String?
  companyEmail  String?
  gender        String?
  position      String?
  employmentDate    DateTime?
  employmentStatus  String @default("Active")

  // Set only once the employee completes "Request Access" (Module 9, SOP 9-2).
  username          String? @unique
  passwordHash      String?
  securityQuestion  String?
  securityAnswerHash String?

  // An account exists (created via Add User) before it can log in.
  // enabled must be explicitly turned on by an administrator (SOP 9-3).
  enabled       Boolean  @default(false)
  requestedAccessAt DateTime?

  // Serialized JSON array of granted permission keys, e.g.
  // ["user.userManagement.manage","dashboard.view", ...]
  // See src/permissions.ts for the canonical permission tree.
  permissions   String   @default("[]")
  isMotherAccount Boolean @default(false)

  lastLogin     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  auditLogs     AuditLog[]
}

model CompanySettings {
  id          Int     @id @default(1)
  // Stored as a data: URL (base64) rather than a file path -- Netlify
  // Functions run on a read-only, ephemeral filesystem, so a small image
  // like a company logo is kept in the database instead of on disk.
  logoDataUrl String?
}

// Lightweight audit trail -- every module in the documentation set has a
// History panel; this table is the shared backing store for that pattern.
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id])
  action    String
  entity    String
  entityId  String?
  metadata  String?
  createdAt DateTime @default(now())
}
