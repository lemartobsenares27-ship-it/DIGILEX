// LHIKE ERP - Prisma schema
// Postgres in production (a Vercel Postgres / Neon database -- see
// server/scripts/provision-db.mjs and api/index.ts). Local development
// also uses Postgres when DATABASE_URL points at one; see
// server/.env.example.
//
// Standard default output (server/node_modules/@prisma/client), no custom
// output path or binaryTargets override: unlike Netlify's esbuild-based
// function bundler, Vercel's Node.js Serverless Functions build with
// @vercel/nft (Node File Trace), which traces the actual require() calls
// Prisma's engine makes at runtime and correctly includes the resulting
// binary in the deployed function -- Vercel's build container and its
// function runtime are also the same OS family, so no cross-platform
// binaryTargets mismatch. This is the standard, officially-documented
// Prisma + Vercel setup.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Mirrors Module 9 (User Management): Employment Status is separate from
// the Enabled/Disabled login toggle. Validated as one of
// Active/Inactive/Resigned/Terminated at the application layer (see
// src/routes/users.ts) rather than as a Prisma enum.
model User {
  id            String   @id @default(cuid())
  employeeNo    String   @unique
  firstName     String
  lastName      String
  middleName    String?
  birthdate     DateTime?
  contactNumber String?
  personalEmail String?
  companyEmail  String?
  gender        String?
  position      String?
  employmentDate    DateTime?
  employmentStatus  String @default("Active")

  // Set only once the employee completes "Request Access" (Module 9, SOP 9-2).
  username          String? @unique
  passwordHash      String?
  securityQuestion  String?
  securityAnswerHash String?

  // An account exists (created via Add User) before it can log in.
  // enabled must be explicitly turned on by an administrator (SOP 9-3).
  enabled       Boolean  @default(false)
  requestedAccessAt DateTime?

  // Serialized JSON array of granted permission keys, e.g.
  // ["user.userManagement.manage","dashboard.view", ...]
  // See src/permissions.ts for the canonical permission tree.
  permissions   String   @default("[]")
  isMotherAccount Boolean @default(false)

  lastLogin     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  auditLogs     AuditLog[]
}

model CompanySettings {
  id          Int     @id @default(1)
  // Stored as a data: URL (base64) rather than a file path -- Netlify
  // Functions run on a read-only, ephemeral filesystem, so a small image
  // like a company logo is kept in the database instead of on disk.
  logoDataUrl String?
}

// Lightweight audit trail -- every module in the documentation set has a
// History panel; this table is the shared backing store for that pattern.
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id])
  action    String
  entity    String
  entityId  String?
  metadata  String?
  createdAt DateTime @default(now())
}

// Module 3, Section 3.5 (Pages & Store). The Pancake Set Up panel (Section
// 3.5.1 / Module 4, SOP 4-1) is optional per page -- a page with no
// pancakeShopId/pancakeApiKey is a page LHIKE ERP doesn't sync orders for.
model Page {
  id          String  @id @default(cuid())
  name        String
  description String?
  owner       String?
  // Facebook ECOM, Instagram, TikTok, Shopee, Lazada, etc. (Module 3.5,
  // free text rather than a Prisma enum, validated at the app layer).
  platform    String
  pageUrl     String?
  // Active, Inactive, In-review, Restricted, Permanently Disabled.
  status      String  @default("Active")
  archived    Boolean @default(false)

  pancakeShopId String?
  pancakeApiKey String?
  // For Pancake "COMBINE" shops only (Module 4, SOP 4-2) -- distinct per
  // linked page, while pancakeShopId/pancakeApiKey are shared.
  pancakePageId String?
  senderName    String?
  internName    String?

  orders    SalesOrder[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

// Module 3, Section 3.8 (Sales Tracker). Scoped to the fields needed for
// the Download Sales from 3P Apps flow (Module 4, SOP 4-3) plus the core
// Sales Tracker table columns; the fuller column set documented in 3.8
// (CSR, Verifier, MOP, Shift, etc.) is not modeled yet.
model SalesOrder {
  id     String @id @default(cuid())
  pageId String
  page   Page   @relation(fields: [pageId], references: [id])

  // "Pancake-POS" for now (the only supported App on the Download Sales
  // from 3P Apps screen so far); Upload Sales Monitoring's other sources
  // (Facebook/Shopify, TikTok, Lazada, Shopee) are not implemented yet.
  source         String  @default("Pancake-POS")
  // Pancake's own order id -- the dedupe key so re-running a download for
  // an overlapping date range skips orders already imported (SOP 4-3).
  pancakeOrderId String?
  displayId      String?

  orderDate     DateTime
  customerName  String?
  address       String?
  contactNumber String?
  itemsSummary  String?
  totalQty      Int      @default(0)
  price         Float    @default(0)
  shippingFee   Float    @default(0)

  trackingNumber String?
  courier        String?
  parcelStatus   String?
  // Canceled, Confirmed, Delivered, Partial Return, Printed (Module 4, SOP 4-3).
  orderStatus    String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([pageId, pancakeOrderId])
}
